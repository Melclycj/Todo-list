# Dependencies — reinstalled inside the image via npm ci
node_modules/

# Build output — rebuilt inside the image via npm run build
dist/

# Local env files — never bake secrets into the image
.env
.env.*
!.env.example

# Test artefacts
coverage/

# Git
.git/
.gitignore

# Docker meta
Dockerfile
.dockerignore

# Dev-only config that should not influence the production image
*.local
